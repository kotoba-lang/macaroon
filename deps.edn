{:paths ["src"]
 ;; `authority` and nothing else. A token format that owned a second copy of
 ;; `covers?` would be the defect `authority.scope` was extracted to remove.
 :deps {io.github.kotoba-lang/authority
        {:git/url "https://github.com/kotoba-lang/authority.git"
         :git/sha "232eef9b7969aa5990f9b5e48b1184f078500781"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/crypto
                      {:git/url "https://github.com/kotoba-lang/crypto.git"
                       :git/sha "992c4d53f36d54047d5f1e797ec9c247271e7581"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
